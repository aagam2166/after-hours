# Database (Supabase PostgreSQL)
# Note: If your password contains special characters like '@', URL-encode them (e.g. '@' becomes '%40')
# Transaction/Pooled connection string (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Direct connection string (port 5432) — used for migrations
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS in production)
FRONTEND_URL="https://your-app.vercel.app"

# OTP (prototype — set to true to skip real SMS)
OTP_MOCK_MODE=true
OTP_MOCK_CODE=1234
